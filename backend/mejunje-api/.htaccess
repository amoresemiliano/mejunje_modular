# MEJUNJE Backoffice API - Apache Rewrite Configuration
# Target directory: /home3/athcomar/public_html/vegendigital/sistemas/mejunje/dev/api/

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Only generated raster filenames may be served from the upload tree.
    RewriteRule ^uploads/images/img-[a-f0-9]{48}\.(jpg|png|webp)$ - [L]
    RewriteRule ^uploads(?:/|$) - [F,L]
    RewriteRule ^media/?$ media.php [L,QSA]
    RewriteRule ^clients/?$ clients.php [L,QSA]
    RewriteRule ^formulas/?$ formulas.php [L,QSA]
    RewriteRule ^catalog-products/?$ catalog-products.php [L,QSA]
    RewriteBase /sistemas/mejunje/dev/api/

    # Allow direct access to physical files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Health check route
    RewriteRule ^health/?$ health.php [L,QSA]

    # Suppliers routes
    RewriteRule ^suppliers/?$ suppliers.php [L,QSA]
    RewriteRule ^suppliers/([^/]+)/?$ suppliers.php?id=$1 [L,QSA]

    # Ingredients routes
    RewriteRule ^ingredients/?$ ingredients.php [L,QSA]
    RewriteRule ^ingredients/([^/]+)/?$ ingredients.php?id=$1 [L,QSA]

    # Purchase Orders routes
    RewriteRule ^purchase-orders/?$ purchase-orders.php [L,QSA]
    RewriteRule ^purchase-orders/([^/]+)/?$ purchase-orders.php?id=$1 [L,QSA]
</IfModule>

# Disable directory browsing
Options -Indexes

# UTF-8 character encoding header
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
