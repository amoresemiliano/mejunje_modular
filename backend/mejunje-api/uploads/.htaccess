Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .jpg .png .webp
RemoveType .php .phtml .phar
<FilesMatch "^(?!img-[a-f0-9]{48}\.(jpg|png|webp)$)">
    Require all denied
</FilesMatch>
AddType image/jpeg .jpg
AddType image/png .png
AddType image/webp .webp
<FilesMatch "^img-[a-f0-9]{48}\.(jpg|png|webp)$">
    SetHandler none
</FilesMatch>
