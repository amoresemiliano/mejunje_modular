# Supabase Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LAB_ORIGIN: Origin of the internal management Lab deployment
# In production Vercel deployment of Storefront, set this to your new Lab deployment URL:
# e.g., LAB_ORIGIN=https://mejunje-lab.vercel.app
LAB_ORIGIN=https://mejunje-lab.vercel.app

# GEMINI_API_KEY: Optional key for Gemini AI features
# GEMINI_API_KEY=MY_GEMINI_API_KEY
